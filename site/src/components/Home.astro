---
import Shot from './Shot.astro';
import Phone from './Phone.astro';
import Icon from './Icon.astro';
import { type Lang, t, repo, releases, project } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const steps = ['git clone https://github.com/C2-POLY/fourchette.git', 'cd fourchette/app', 'cargo run --release -- ~/path/to/a/repository'];
---

<section class="hero">
  <div class="wrap">
    <p class="badge">{s.hero.badge}</p>
    <h1>{s.hero.titleStart} <span class="accent">{s.hero.titleAccent}</span></h1>
    <p class="lead">{s.hero.lead}</p>
    <div class="actions">
      <a class="button primary" href={releases}>{s.hero.primary}</a>
      <a class="button" href={repo}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z"></path></svg>
        {s.hero.secondary}
      </a>
    </div>
    <Shot name="history" alt={s.hero.shotAlt} eager />
  </div>
</section>

<section id="features" class="section">
  <div class="wrap">
    <h2>{s.features.title}</h2>
    <ul class="grid">
      {
        s.features.items.map((f) => (
          <li class="card">
            <Icon name={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  s.showcase.map((sc, i) => (
    <section class:list={['section', 'showcase', { alt: i % 2 === 1 }]}>
      <div class="wrap">
        <div class="showcase-text">
          <p class="kicker">{sc.kicker}</p>
          <h2>{sc.title}</h2>
          <p class="lead">{sc.text}</p>
        </div>
        <Shot name={sc.shot} alt={sc.alt} />
      </div>
    </section>
  ))
}

<section class:list={['section', 'showcase', { alt: s.showcase.length % 2 === 1 }]}>
  <div class="wrap">
    <div class="showcase-text">
      <p class="kicker">{s.companion.kicker}</p>
      <h2>{s.companion.title}</h2>
      <p class="lead">{s.companion.text}</p>
      <p class="dim">{s.companion.note}</p>
    </div>
    <div class="phones">
      {s.companion.shots.map((p) => <Phone name={p.name} alt={p.alt} />)}
    </div>
  </div>
</section>

<section id="teams" class="section">
  <div class="wrap">
    <h2>{s.teams.title}</h2>
    <ul class="grid three">
      {
        s.teams.items.map((it) => (
          <li class="card">
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="build" class="section">
  <div class="wrap build">
    <div>
      <h2>{s.build.title}</h2>
      <p class="lead">{s.build.lead}</p>
      <p><a class="button primary" href={releases}>{s.build.download}</a></p>
      <h3>{s.build.installTitle}</h3>
      <ol class="needs">
        {s.build.install.map((n) => <li>{n}</li>)}
      </ol>
      <h3>{s.build.needsTitle}</h3>
      <ul class="needs">
        {s.build.needs.map((n) => <li>{n}</li>)}
      </ul>
    </div>
    <div>
      <h3>{s.build.stepsTitle}</h3>
      <div class="terminal">
        <div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <pre><code>{steps.map((l) => <span class="line"><span class="prompt" aria-hidden="true">$ </span>{l}</span>)}</code></pre>
        <button class="copy" type="button" data-copy={steps.join('\n')} data-done={s.build.copied}>{s.build.copy}</button>
      </div>
      <p class="dim small-text">{s.build.note}</p>
    </div>
  </div>
</section>

<section class="section open">
  <div class="wrap">
    <h2>{s.open.title}</h2>
    <p class="lead">{s.open.text}</p>
    <div class="actions center">
      <a class="button primary" href={repo}>{s.open.code}</a>
      <a class="button" href={`${repo}/issues`}>{s.open.issues}</a>
      <a class="button" href={project}>{s.open.roadmap}</a>
    </div>
  </div>
</section>

<script>
  // Copies the build commands, and says so on the button for a moment.
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = b.dataset.done ?? label;
        setTimeout(() => (b.textContent = label), 1600);
      } catch {}
    });
  });
</script>
