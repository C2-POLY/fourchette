---
// The feature icons, drawn in the app's thin-stroke style on a 24 px grid.
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'graph' && (
      <>
        <circle cx="7" cy="5" r="2" />
        <circle cx="7" cy="19" r="2" />
        <circle cx="17" cy="9" r="2" />
        <path d="M7 7v10M17 11c0 4-10 2-10 6" />
      </>
    )
  }
  {
    name === 'undo' && (
      <>
        <path d="M9 14 4 9l5-5" />
        <path d="M4 9h10a6 6 0 0 1 0 12h-3" />
      </>
    )
  }
  {
    name === 'worktree' && (
      <>
        <path d="M3 7.5V18a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9.5a2 2 0 0 0-2-2h-7l-2-3H5a2 2 0 0 0-2 2z" />
        <path d="M10 16v-4M10 12c0 2 4 1 4 3" />
      </>
    )
  }
  {
    name === 'board' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M8 7.5v8M12 7.5v4M16 7.5v6" />
      </>
    )
  }
  {
    name === 'palette' && (
      <>
        <rect x="2.5" y="6" width="19" height="12" rx="2.5" />
        <path d="M6 10h1M10 10h1M14 10h1M18 10h0M7 14h10" />
      </>
    )
  }
  {
    name === 'spark' && (
      <>
        <path d="M12 3c.6 4.2 2.8 6.4 7 7-4.2.6-6.4 2.8-7 7-.6-4.2-2.8-6.4-7-7 4.2-.6 6.4-2.8 7-7z" />
        <path d="M19 15.5c.25 1.6 1 2.3 2.5 2.5-1.5.2-2.25.9-2.5 2.5-.25-1.6-1-2.3-2.5-2.5 1.5-.2 2.25-.9 2.5-2.5z" />
      </>
    )
  }
</svg>
