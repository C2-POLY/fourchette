---
// One screenshot in both modes at once, the light one over the dark one and
// cut at a seam that scripts/motion.ts sweeps across on scroll (half and half
// without it), so the section about themes shows both.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
}

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const { name, alt } = Astro.props;
const src = (mode: string) => shots[`../assets/shots/${name}-${mode}.png`].default;
const sizes = '(min-width: 1240px) 1100px, calc(100vw - 64px)';
const widths = [700, 1200, 1800];
---

<div class="shot wipe" data-wipe>
  <Image src={src('dark')} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  <div class="wipe-over" data-wipe-over>
    <Image src={src('light')} alt="" widths={widths} sizes={sizes} loading="lazy" />
  </div>
  <span class="wipe-seam" data-wipe-seam></span>
</div>
