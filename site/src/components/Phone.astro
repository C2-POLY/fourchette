---
// A screenshot of the iPhone companion in both modes, like Shot: the page shows the one that matches its theme.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
}

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/phones/*.png', { eager: true });
const { name, alt } = Astro.props;
const src = (mode: string) => shots[`../assets/phones/${name}-${mode}.png`].default;
const sizes = '(min-width: 900px) 300px, 30vw';
const widths = [300, 600, 900];
---

<div class="phone">
  <Image class="shot-dark" src={src('dark')} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  <Image class="shot-light" src={src('light')} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
</div>
