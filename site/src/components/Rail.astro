---
// The graph's lanes down the left of a section, so the page reads as one
// history: `main` runs through every section, a `branch` section forks onto
// its own lane and merges back, `start` gathers the lanes into main at the top
// of the page and `end` stops main at its last commit. Drawn on scroll by
// scripts/motion.ts; fully drawn without it.
interface Props {
  kind: 'start' | 'main' | 'branch' | 'end';
}

const { kind } = Astro.props;
---

<div class:list={['rail', `rail-${kind}`]} aria-hidden="true" data-rail>
  {
    kind === 'start' && (
      <svg class="gather" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path class="l1" d="M95 0C95 55 28 45 28 100" pathLength="1" />
        <path class="l2" d="M67 0C67 60 28 40 28 100" pathLength="1" />
        <path class="l3" d="M5 0C5 60 28 40 28 100" pathLength="1" />
      </svg>
    )
  }
  <span class="trunk" data-trunk></span>
  {
    kind === 'branch' && (
      <>
        <svg class="fork" viewBox="0 0 10 40" preserveAspectRatio="none" data-curve>
          <path d="M0 0C0 24 10 16 10 40" pathLength="1" />
        </svg>
        <span class="branch" data-branch />
        <svg class="merge" viewBox="0 0 10 40" preserveAspectRatio="none" data-curve>
          <path d="M10 0C10 24 0 16 0 40" pathLength="1" />
        </svg>
      </>
    )
  }
  <span class="node" data-node></span>
</div>

<script>
  // Puts each rail's commit dot level with its section's commit line. The
  // stylesheet's --node-y only guesses it from the padding, which is wrong
  // where the text is centred beside a picture; this measures it instead, at
  // every size and with or without the motion. A sticky header is left to
  // the stylesheet: once stuck its line has moved and the dot should not follow.
  const offset = (el: HTMLElement, to: HTMLElement) => {
    let y = 0;
    for (let e: HTMLElement | null = el; e && e !== to; e = e.offsetParent as HTMLElement | null) y += e.offsetTop;
    return y;
  };

  const align = () => {
    for (const rail of document.querySelectorAll<HTMLElement>('[data-rail]')) {
      const section = rail.closest('section');
      const line = section?.querySelector<HTMLElement>('.commit-line');
      if (!section || !line || line.closest('.sticky-head')) continue;
      const y = offset(line, section) + line.offsetHeight / 2 - offset(rail, section);
      rail.style.setProperty('--node-y', `${Math.round(y)}px`);
    }
  };

  align();
  const sizes = new ResizeObserver(align);
  // The section, its body and the block holding the line: pinning the stage
  // (scripts/motion.ts) moves its line without changing the section's size.
  document.querySelectorAll('section.commit').forEach((s) => {
    sizes.observe(s);
    s.querySelectorAll('.body, .commit-line').forEach((e) => sizes.observe(e.parentElement ?? e));
  });
  document.fonts?.ready.then(align);
</script>
