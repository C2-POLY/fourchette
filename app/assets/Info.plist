<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into the binary's __TEXT,__info_plist section by build.rs, so macOS names the app
     "Fourchette" (menu bar, About) even when it runs from target/ rather than an .app bundle. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Fourchette</string>
	<key>CFBundleDisplayName</key>
	<string>Fourchette</string>
	<key>CFBundleExecutable</key>
	<string>fourchette</string>
</dict>
</plist>
